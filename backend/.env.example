# Example only — replace values for local development. Never use these sample keys in production.
FLASK_ENV=development
SECRET_KEY=replace-with-a-long-random-secret
DATABASE_URL=postgresql://user:password@localhost:5432/rakshana_dev
JWT_SECRET_KEY=replace-with-a-separate-long-random-secret
ENCRYPTION_KEY=0123456789abcdef0123456789abcdef
REDIS_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/1
TELEGRAM_API_ID=
TELEGRAM_API_HASH=
TELEGRAM_PHONE=
TELEGRAM_CHANNELS=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
SCAN_INTERVAL_HOURS=4
THREAT_WATCH_THRESHOLD=40
THREAT_ALERT_THRESHOLD=70
THREAT_CRITICAL_THRESHOLD=90
JWT_ACCESS_TOKEN_EXPIRES=3600
JWT_REFRESH_TOKEN_EXPIRES=2592000
CORS_ORIGINS=http://localhost,http://127.0.0.1,http://localhost:3000
